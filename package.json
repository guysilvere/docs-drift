{
  "name": "docs-drift-cli",
  "version": "0.5.0",
  "description": "Local and CI linter that keeps Markdown documentation strictly aligned with real code",
  "author": "Silvere Meya",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/guysilvere/docs-drift-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guysilvere/docs-drift-cli.git"
  },
  "bugs": {
    "url": "https://github.com/guysilvere/docs-drift-cli/issues"
  },
  "keywords": [
    "markdown",
    "linter",
    "documentation",
    "living-docs",
    "docs-drift",
    "cli",
    "ci",
    "sarif",
    "sveltekit",
    "sql",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "docs-drift": "./dist/cli.js",
    "docs-drift-cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test:run && npm run build && node dist/cli.js check"
  },
  "dependencies": {
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
